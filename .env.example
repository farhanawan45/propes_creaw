# SMTP credentials used by /api/contact (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Where enquiry emails are sent, and the "from" address used to send them.
CONTACT_TO_EMAIL=friends@propsncrew.co.nz
CONTACT_FROM_EMAIL=friends@propsncrew.co.nz

# Optional inbox for newsletter signups. Falls back to CONTACT_TO_EMAIL.
NEWSLETTER_TO_EMAIL=friends@propsncrew.co.nz

# Public site URL (used for metadata, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://propsncrew.co.nz

# GoDaddy Managed MySQL database used for enquiries and subscribers.
DB_HOST=your-database-host
DB_PORT=3306
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=your-database-name
DB_SSL=false

# Secure admin portal at /admin. Use a unique 12+ character password and a
# randomly generated session secret of at least 32 characters.
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret
